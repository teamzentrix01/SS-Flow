  @@id([plantId, prefix, year])
  @@map("number_sequences")
}

model Customer {
  id        String       @id @db.Uuid
  plantId   String       @map("plant_id") @db.Uuid
  code      String
  name      String
  phone     String?
  isDemo    Boolean      @default(false) @map("is_demo")
  plant     Plant        @relation(fields: [plantId], references: [id])
  portalUser User?
  orders    SalesOrder[]
  @@unique([plantId, code])
  @@map("customers")
}

model SalesOrder {
  id            String           @id @db.Uuid
  plantId       String           @map("plant_id") @db.Uuid
  customerId    String           @map("customer_id") @db.Uuid
  number        String
  status        String           @default("draft")
  priority      String           @default("normal")
  orderDate     DateTime         @default(now()) @map("order_date") @db.Date
  promisedDate  DateTime?        @map("promised_date") @db.Date
  notes         String?
  productionNotes String?        @map("production_notes")
  onHoldReason  String?          @map("on_hold_reason")
  approvedBy    String?          @map("approved_by") @db.Uuid
  approvedAt    DateTime?        @map("approved_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  plant         Plant            @relation(fields: [plantId], references: [id])
  customer      Customer         @relation(fields: [customerId], references: [id])
  items         SalesOrderItem[]
  shipments     Shipment[]
  statusEvents  SalesOrderStatusEvent[]
  requirements  MaterialRequirement[]
  productionOrders ProductionOrder[]
  materialRequests MaterialRequest[]
  jobCards         JobCard[]
  @@unique([plantId, number])
  @@index([plantId, status, promisedDate])
  @@map("sales_orders")
}

model SalesOrderStatusEvent {
  id         String     @id @db.Uuid
  orderId    String     @map("order_id") @db.Uuid
  fromStatus String?    @map("from_status")
  toStatus   String     @map("to_status")
  remarks    String?
  userId     String     @map("user_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  order      SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId, createdAt(sort: Desc)])
  @@map("sales_order_status_events")
}

model SalesOrderItem {
  id             String     @id @db.Uuid
  orderId        String     @map("order_id") @db.Uuid
  productId      String     @map("product_id") @db.Uuid
  batchId        String?    @map("batch_id") @db.Uuid
  qtyOrdered     Decimal    @map("qty_ordered") @db.Decimal(18, 3)
  qtyProduced    Decimal    @default(0) @map("qty_produced") @db.Decimal(18, 3)
  qtyDispatched  Decimal    @default(0) @map("qty_dispatched") @db.Decimal(18, 3)
  unitPrice      Decimal    @default(0) @map("unit_price") @db.Decimal(18, 2)
  taxPct         Decimal    @default(0) @map("tax_pct") @db.Decimal(8, 4)
  discountPct    Decimal    @default(0) @map("discount_pct") @db.Decimal(8, 4)
  uom            String     @default("PCS")
  specs          Json       @default("{}")
  legacyQty      Decimal?   @map("legacy_qty") @db.Decimal(18, 3)
  order          SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        MaterialMaster @relation(fields: [productId], references: [id])
  productionOrders ProductionOrder[]
  jobCards       JobCard[]
  requirements   MaterialRequirement[]
  reservations   StockReservation[]
  shipmentItems  ShipmentItem[]
  @@map("sales_order_items")
}

model MaterialRequirement {
  id              String   @id @db.Uuid
  plantId         String   @map("plant_id") @db.Uuid
  salesOrderId    String   @map("sales_order_id") @db.Uuid
  salesOrderItemId String  @map("sales_order_item_id") @db.Uuid
  materialId      String   @map("material_id") @db.Uuid
  grossQty        Decimal  @map("gross_qty") @db.Decimal(18, 3)
  scrapQty        Decimal  @map("scrap_qty") @db.Decimal(18, 3)
  netQty          Decimal  @map("net_qty") @db.Decimal(18, 3)
  uom             String   @default("KG")
  calcVersion     Int      @default(1) @map("calc_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  plant           Plant    @relation(fields: [plantId], references: [id])
  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  salesOrderItem  SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  material        MaterialMaster @relation(fields: [materialId], references: [id])
  purchaseOrderItems PurchaseOrderItem[]
  requisitionItems PurchaseRequisitionItem[]
  @@index([salesOrderId])
  @@index([materialId])
  @@map("material_requirements")
}

model StockReservation {
  id               String   @id @db.Uuid
  plantId          String   @map("plant_id") @db.Uuid
  batchId          String   @map("batch_id") @db.Uuid
  locationId       String   @map("location_id") @db.Uuid
  qty              Decimal  @db.Decimal(18, 3)
  uom              String   @default("KG")
  referenceType    String   @map("reference_type")
  referenceId      String   @map("reference_id") @db.Uuid
  salesOrderItemId String?  @map("sales_order_item_id") @db.Uuid
  status           String   @default("active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  plant            Plant    @relation(fields: [plantId], references: [id])
  batch            MaterialBatch @relation(fields: [batchId], references: [id])
  salesOrderItem   SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id])
  @@index([referenceType, referenceId])
  @@index([batchId, status])
  @@map("stock_reservations")
}

model MaterialRequest {
  id               String   @id @db.Uuid
  plantId          String   @map("plant_id") @db.Uuid
  number           String
  employeeId       String   @map("employee_id") @db.Uuid
  jobId            String?  @map("job_id") @db.Uuid
  salesOrderId     String?  @map("sales_order_id") @db.Uuid
  materialId       String   @map("material_id") @db.Uuid
  qtyRequired      Decimal  @map("qty_required") @db.Decimal(18, 3)
  qtyFulfilled     Decimal  @default(0) @map("qty_fulfilled") @db.Decimal(18, 3)
  reason           String
  priority         String   @default("normal")
  requiredBy       DateTime? @map("required_by") @db.Date
  status           String   @default("requested")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  plant            Plant    @relation(fields: [plantId], references: [id])
  employee         Employee @relation(fields: [employeeId], references: [id])
  job              JobCard? @relation(fields: [jobId], references: [id])
  salesOrder       SalesOrder? @relation(fields: [salesOrderId], references: [id])
  material         MaterialMaster @relation(fields: [materialId], references: [id])
  events           MaterialRequestEvent[]
  @@unique([plantId, number])
  @@index([plantId, status])
  @@map("material_requests")
}

model MaterialRequestEvent {
  id         String          @id @db.Uuid
  requestId  String          @map("request_id") @db.Uuid
  fromStatus String?         @map("from_status")
  toStatus   String          @map("to_status")
  remarks    String?
  userId     String          @map("user_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  request    MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@index([requestId, createdAt(sort: Desc)])
  @@map("material_request_events")
}

model JobStatusEvent {
  id         String   @id @db.Uuid
  jobId      String   @map("job_id") @db.Uuid
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  remarks    String?
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  job        JobCard  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@index([jobId, createdAt(sort: Desc)])
  @@map("job_status_events")
}

model PurchaseRequisition {
  id        String   @id @db.Uuid
  plantId   String   @map("plant_id") @db.Uuid
