  parent        MaterialBatch @relation("ParentBatch", fields: [parentBatchId], references: [id])
  child         MaterialBatch @relation("ChildBatch", fields: [childBatchId], references: [id])
  @@index([childBatchId])
  @@index([parentBatchId])
  @@map("batch_links")
}

model PlantDailyStat {
  plantId    String   @map("plant_id") @db.Uuid
