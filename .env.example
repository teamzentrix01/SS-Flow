# App runtime: Neon pooler (-pooler host) is fine for Next.js / Prisma Client.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DATABASE?sslmode=require&schema=ss_flow"
# Migrations only: direct (non-pooler) host — required for pg_advisory_lock (avoid P1002).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DATABASE?sslmode=require&schema=ss_flow"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_TO_A_STRONG_PASSWORD"
DEMO_USER_PASSWORD="CHANGE_TO_A_DIFFERENT_STRONG_PASSWORD"

# The single operational entity used by the app (defaults to PLANT-01)
ACTIVE_ENTITY_PLANT_CODE="PLANT-01"

# Public website enquiries (plant code for POST /api/public/v1/enquiries)
PUBLIC_LEAD_PLANT_CODE="PLANT-01"

# SMTP — enquiry / lead updates to the email on the lead form
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="SS Metals <enquiry@ssmetals.in>"
# Dev: log emails to console instead of sending
# SMTP_LOG_ONLY="1"

# Optional: protect POST /api/v1/jobs/deliver-notifications
# CRON_SECRET="change-me"

# Quotation defaults (also used by POST /api/v1/jobs/quotation-expiry)
# QUOTATION_VALIDITY_DAYS="1"
# QUOTATION_MAX_DISCOUNT_PCT="10"

# Days after conversion before repeat-order follow-up (lead/customer override wins)
# REPEAT_ORDER_FOLLOW_UP_DAYS="30"
